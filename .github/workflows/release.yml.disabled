name: Release
on:
  workflow_dispatch:
    inputs:
      version:
        description: Player release version, for example 4.0
        required: true
        type: string
      prerelease:
        description: Beta on test; disable only after approving production
        default: true
        type: boolean
permissions:
  contents: write
concurrency:
  group: release-${{ inputs.version }}
  cancel-in-progress: false
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run validate
      - run: npm test
      - run: npm run format:check
      - name: Create release notes and package
        env:
          VERSION: ${{ inputs.version }}
          PRERELEASE: ${{ inputs.prerelease }}
          GH_TOKEN: ${{ github.token }}
        run: node scripts/create-github-release.mjs --version "$VERSION" --prerelease "$PRERELEASE"
