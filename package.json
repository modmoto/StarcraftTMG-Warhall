{
  "name": "starcraft-warhall-data",
  "private": true,
  "type": "module",
  "scripts": {
    "convert": "node scripts/convert.mjs",
    "deployments:update": "node scripts/update-deployments.mjs",
    "deployments:check": "node scripts/update-deployments.mjs --check",
    "terrain:update": "node scripts/update-terrain.mjs",
    "terrain:check": "node scripts/update-terrain.mjs --check",
    "terrain:review": "node scripts/review-terrain.mjs",
    "validate": "node scripts/validate.mjs",
    "check:local": "node scripts/check-local.mjs",
    "test": "node --test",
    "format": "prettier --write \"scripts/**/*.mjs\" \"src/**/*.mjs\" \"test/*.mjs\" package.json .prettierrc.json",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"src/**/*.mjs\" \"test/*.mjs\" package.json .prettierrc.json",
    "rules:update-keywords": "node scripts/update-rule-keywords.mjs",
    "rules:compare": "node scripts/compare-rule-references.mjs",
    "models:catalogue": "node scripts/build-model-catalogue.mjs",
    "models:publish": "node scripts/publish-model-catalogue.mjs",
    "models:thumbnails": "node scripts/generate-model-thumbnails.mjs",
    "auth:setup": "node scripts/setup-local-auth.mjs",
    "auth:github": "node scripts/setup-github-auth.mjs",
    "models:credentials": "node scripts/manage-model-credentials.mjs",
    "models:repair": "node scripts/repair-model-transforms.mjs",
    "models:menus": "node scripts/sync-menu-bindings.mjs",
    "tokens:update": "node scripts/update-tokens.mjs",
    "tokens:check": "node scripts/update-tokens.mjs --check",
    "channel:prepare": "node scripts/prepare-channel.mjs",
    "release:context": "node scripts/release-notes-context.mjs",
    "release:stage": "node scripts/wave-release.mjs stage",
    "release:promote": "node scripts/wave-release.mjs promote"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
