{
  "name": "starcraft-warhall-data",
  "private": true,
  "type": "module",
  "scripts": {
    "convert": "node scripts/data/convert.mjs",
    "deployments:update": "node scripts/deployments/update-deployments.mjs",
    "terrain:update": "node scripts/terrain/update-terrain.mjs",
    "validate": "node scripts/data/validate.mjs",
    "check:local": "node scripts/checks/check-local.mjs",
    "test": "node --test",
    "format": "prettier --write \"scripts/**/*.mjs\" \"src/**/*.mjs\" \"test/*.mjs\" package.json .prettierrc.json",
    "rules:update-keywords": "node scripts/data/update-rule-keywords.mjs",
    "models:catalogue": "node scripts/models/build-model-catalogue.mjs",
    "models:publish": "node scripts/models/publish-model-catalogue.mjs",
    "auth:setup": "node scripts/auth/setup-local-auth.mjs",
    "auth:github": "node scripts/auth/setup-github-auth.mjs",
    "models:credentials": "node scripts/auth/manage-model-credentials.mjs",
    "models:menus": "node scripts/models/sync-menu-bindings.mjs",
    "tokens:update": "node scripts/tokens/update-tokens.mjs",
    "lists:parse": "node scripts/imports/parse-nr-list.mjs",
    "rules:update-book": "node scripts/data/update-rulebook.mjs",
    "cards:update": "node scripts/cards/update-cards.mjs",
    "test:setup": "node scripts/checks/setup-test-environment.mjs",
    "release:promote": "node scripts/release/promote-release.mjs",
    "wave:update": "node scripts/data/update-wave.mjs",
    "wave:bases": "node scripts/data/update-db-bases.mjs"
