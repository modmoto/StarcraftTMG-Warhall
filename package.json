  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
